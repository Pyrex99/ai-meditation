# Copy to keys.env (gitignored) or ~/.config/mala-lab/keys.env and fill in. Read at startup.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
RUNPOD_API_KEY=
RUNPOD_POD_ID=
HF_TOKEN=
# Passcode for the app. Required whenever it's reachable from the internet (a RunPod URL is).
MALA_TOKEN=
# On the pod: sim or interp
MALA_ENGINE=interp
